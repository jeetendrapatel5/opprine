generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  plan      Plan      @default(FREE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]

  bio          String?  
  avatarUrl    String?   
  portfolioUrl String?   

  username       String?  @unique
  profileEnabled Boolean  @default(false)
  profileTagline String?

  bankAccounts BankAccount[]

  // Every user has at least one WorkspaceMember row (their own workspace,
  // created automatically). Can have more later if invited into others.
  workspaceMemberships WorkspaceMember[]

  // Which workspace the UI should show right now, for a user who
  // belongs to more than one. Deliberately a plain scalar, NOT a
  // Prisma @relation — getWorkspaceForUser() re-checks this against a
  // real WorkspaceMember row on every read, so a stale/dangling value
  // (e.g. after they're removed from that workspace) just falls back
  // safely instead of needing DB-level FK integrity.
  activeWorkspaceId String?

  // Invites this user has personally sent (as OWNER/ADMIN of some
  // workspace). Optional + SetNull on delete (see WorkspaceInvite
  // below) so deleting this user's account doesn't wipe out invites
  // still pending for OTHER people.
  sentInvites WorkspaceInvite[] @relation("SentInvites")

  // Projects this user is staffed on, with a project-scoped role
  // (PROJECT_MANAGER / CONTRIBUTOR / VIEWER). This is a SEPARATE axis
  // from WorkspaceRole above — see ProjectMember below for why they
  // can't be merged. See lib/project.js for how the two combine.
  projectMemberships ProjectMember[]

  // Two distinct relations from User into Task (who it's assigned to,
  // who created it) — both need an explicit @relation name below or
  // Prisma can't tell them apart.
  assignedTasks Task[] @relation("AssignedTasks")
  createdTasks  Task[] @relation("CreatedTasks")

  // Milestones this user created. No relation name needed — Milestone
  // only has this one relation into User.
  createdMilestones Milestone[]
}

// A Workspace is the new "billing owner." One subscription belongs to
// one Workspace. Today every Workspace has exactly one member (the person
// who signed up), auto-created for them — see the migration note below.
// Later, when we build "invite a teammate," we just add more
// WorkspaceMember rows to an existing Workspace. Nothing here changes then.
model Workspace {
  id        String   @id @default(cuid())
  name      String   // shown in UI, e.g. "Jeetu's Workspace" — editable later
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      WorkspaceMember[]
  projects     Project[]
  subscription Subscription?
  invites      WorkspaceInvite[]
}

// Join table: connects a User to a Workspace, with a role.
// A User can (in the future) be a member of more than one Workspace
// (e.g. their own solo workspace + a client's team workspace they were
// invited into). That's why this is a separate table instead of a
// single workspaceId column on User.
model WorkspaceMember {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(OWNER)
  joinedAt    DateTime      @default(now())

  // A user can't be added to the same workspace twice.
  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

enum WorkspaceRole {
  OWNER  // created the workspace, or the original solo-migrated user
  ADMIN  // future: can manage members/billing but didn't create it
  MEMBER // future: regular teammate, no billing access
}

// A pending (or resolved) invite to join a Workspace. Separate table
// from WorkspaceMember on purpose — a row here just means "an invite
// was sent," not "this person is in the workspace." A WorkspaceMember
// row only gets created once acceptInvite() actually runs.
model WorkspaceInvite {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  email String // who the invite was sent to — may or may not have an account yet
  role  WorkspaceRole // the role they'll get on accept — set by the inviter, never chosen by the invitee (see acceptInvite)

  status InviteStatus @default(PENDING)

  // Same @unique + @default(cuid()) pattern as Client.magicToken above —
  // an opaque string safe to put in a public URL
  // (app/invite/[token]/page.jsx), unrelated to the row's internal id.
  token     String   @unique @default(cuid())
  expiresAt DateTime // set at creation time as now() + 24 hours

  // Optional + SetNull: if the inviter's account is later deleted, this
  // invite should NOT disappear with them — the invitee should still be
  // able to accept it. We just lose the "who sent this" attribution.
  invitedByUserId String?
  invitedBy       User?    @relation("SentInvites", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // bumped on every re-invite (upsert), so "last sent" is always accurate

  // Re-inviting the same email to the same workspace after a
  // revoke/expiry must go through upsert() on this constraint — same
  // pattern checkout/route.js already uses for Subscription — not
  // create(), which would throw on the second invite to the same email.
  @@unique([workspaceId, email])
}

enum InviteStatus {
  PENDING  // sent, not yet acted on — may also be past expiresAt; we check that at read time, not with a separate stored status
  ACCEPTED // acceptInvite() ran successfully
  REVOKED  // an OWNER/ADMIN explicitly cancelled it before it was accepted
}

// Join table: connects a User to a Project, with a PROJECT-scoped
// role. This is a second, separate axis from WorkspaceMember above —
// WorkspaceRole answers "what can this person do to the agency,"
// ProjectRole answers "what can this person do on this one client
// engagement." A user can be PROJECT_MANAGER on one project and
// CONTRIBUTOR on another, in the same workspace, at the same time —
// which is exactly why the role has to live here and not on
// WorkspaceMember.
//
// A ProjectMember row should only ever be created for a user who is
// ALREADY a WorkspaceMember of this project's workspace — Prisma
// can't express that constraint at the schema level, so
// addProjectMember() in lib/project.js checks it directly before
// writing this row.
model ProjectMember {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      ProjectRole @default(CONTRIBUTOR)
  addedAt   DateTime    @default(now())

  // A user can't be staffed on the same project twice.
  @@unique([projectId, userId])
  // @@unique above already gives an efficient index for "who's staffed
  // on this project" (projectId is the leading column). This second
  // index is for the other direction — "which projects is this user
  // staffed on" — same reasoning as WorkspaceMember's @@index([workspaceId]).
  @@index([userId])
}

enum ProjectRole {
  PROJECT_MANAGER // can create/edit/reorder milestones, staff people onto the project
  CONTRIBUTOR     // can create tasks, work assigned tasks, post updates — default role
  VIEWER          // read-only — reserved for future use, e.g. a stakeholder who shouldn't edit anything
}

model BankAccount {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label             String  
  bankName          String  
  accountHolderName String  
  currency          String   @default("INR")
  country           String? 
  isDefault         Boolean  @default(false)

  accountNumberLast4 String
  accountNumberEnc String  
  routingCodeEnc   String? 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?  
  status      Status    @default(ACTIVE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  client      Client?
  updates     Update[]
  files       File[]
  milestones  Milestone[]
  members     ProjectMember[]
  isPublic      Boolean   @default(false)
  publicSlug    String?   @unique 
  clientRating  Int?    
  testimonial   String?   @db.Text
  inquiries     Inquiry[]
  invoices      Invoice[]

  // ── Project Story / Case Study fields ─────────────────────────────────────
  // caseStudyEnabled gates the full story view on /showcase/[slug].
  // When false, the page renders the MVP layout (testimonial + files only).
  // When true, the full case study layout renders.
  caseStudyEnabled    Boolean  @default(false)

  // caseStudyProblem + caseStudyOutcome are the two narrative paragraphs.
  // Written by the freelancer for prospective clients, not for the project client.
  caseStudyProblem    String?  @db.Text
  caseStudyOutcome    String?  @db.Text

  // caseStudyTechStack — array of technology name strings.
  // e.g. ["Next.js", "PostgreSQL", "Stripe"]
  // @default([]) means existing rows get an empty array, not null.
  // Safe to .map() without a null check.
  caseStudyTechStack  String[] @default([])

  // caseStudyHideClient — privacy toggle, default true.
  // When true: render "A satisfied client" instead of client.name.
  // Freelancer explicitly opts in to showing the real name.
  caseStudyHideClient Boolean  @default(true)

  // caseStudyCoverImage — Cloudinary URL for the hero image.
  // If null, the showcase page auto-selects the first completed milestone's
  // deliveryFileUrl that is an image type.
  caseStudyCoverImage String?

  // caseStudyIndustry — single-select label.
  // e.g. "E-commerce", "SaaS", "Healthcare"
  // Shown as a badge on the showcase page.
  caseStudyIndustry   String?

  githubRepoOwner     String?   // e.g. "jeetu-dev" — just for display, not required for the webhook to work
  githubRepoName      String?   // e.g. "acme-website" — same, just for display
  githubWebhookSecret String?   // a random string only you and GitHub know — this is what makes step 3 possible

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
}

model File {
  id        String   @id @default(cuid())
  name      String      
  url       String        
  fileType  String        
  size      Int          
  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Client {
  id         String   @id @default(cuid())
  name       String
  email      String
  magicToken String   @unique @default(cuid())
  lastViewedAt DateTime?
  createdAt  DateTime @default(now())
  projectId  String   @unique
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Update {
  id        String      @id @default(cuid())
  text      String
  status    UpdateStatus @default(IN_PROGRESS)
  approvedAt  DateTime?
  createdAt DateTime    @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type        UpdateType @default(MANUAL)
  commitSha   String?    // short commit hash, only set when type = AUTO_DEPLOY
  commitUrl   String?    // link to the commit on GitHub
  previewUrl  String?    // filled in later, in the Vercel add-on (Part 9)
}

model Milestone {
  id          String          @id @default(cuid())
  title       String
  order       Int             
  status      MilestoneStatus @default(PENDING)
  approvedAt  DateTime?
  rejectionNote String?
  
  // When this milestone reached COMPLETED status — set automatically by the API
  completedAt   DateTime?                          // NEW

  // Scheduling
  dueDate       DateTime?                          // NEW — freelancer can set a target date

  // Delivery card — freelancer fills these before sending to client for review
  deliveryHeadline  String?                        // NEW — e.g. "Homepage is ready for review"
  deliverySummary   String?                        // NEW — paragraph explaining what was done
  deliveryFileUrl   String?                        // NEW — Cloudinary URL of the main deliverable
  deliveryFileName  String?                        // NEW — original filename shown to client
  deliveryFileType  String?                        // NEW — MIME type e.g. "image/png"
  deliveryChecklist String[]    @default([])       // NEW — checklist items client should verify
  deliveryAnnotations Json?
         
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneUpdates MilestoneUpdate[]
  messages         MilestoneMessage[]
  invoices         Invoice[]
  tasks            Task[]

  // Who created this milestone. Deliberately OPTIONAL (String?, not
  // String) — you already have real Milestone rows in production
  // (this isn't a fresh model like Task/ProjectMember below), and a
  // required FK on an existing table needs a backfill migration
  // before it can go NOT NULL. Every NEW milestone must set this at
  // creation time in application code — enforce it there, not in the
  // schema, same tradeoff already made for activeWorkspaceId.
  createdByUserId String?
  createdBy       User?    @relation(fields: [createdByUserId], references: [id])
}

// A granular, INTERNAL work item under a Milestone. Never exposed on
// any client-facing (magic-link) route — clients see Milestone's
// delivery card, never the raw task list. Enforce that at the API
// layer: client-facing endpoints should simply never query this model.
//
// Unlike Milestone (gated to PROJECT_MANAGER/ADMIN/OWNER), any
// ProjectMember staffed on the project can create a Task — see
// requireProjectMembership() in lib/project.js, called with no
// additional role check for task creation.
model Task {
  id          String     @id @default(cuid())
  title       String
  description String?    @db.Text
  status      TaskStatus @default(TODO)
  order       Int        @default(0)
  dueDate     DateTime?

  milestoneId String
  milestone   Milestone  @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  // Optional + SetNull: a task can briefly exist unassigned, and if
  // the assigned person's account is later removed, the task should
  // become unassigned again, not disappear — same reasoning as
  // WorkspaceInvite.invitedByUserId.
  assignedToId String?
  assignedTo   User?      @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Required, no SetNull — this is a brand-new model with no existing
  // rows, so (unlike Milestone.createdByUserId above) there's no
  // backfill problem, and every Task should always know who made it.
  createdByUserId String
  createdBy       User    @relation("CreatedTasks", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([milestoneId])
  @@index([assignedToId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

model MilestoneUpdate {
  id        String   @id @default(cuid())
  note      String   @db.Text    // The freelancer's written note
  fileUrl   String?              // Cloudinary URL — null if no file attached
  fileName  String?              // Original filename shown to client
  fileType  String?              // MIME type e.g. "image/png", "application/pdf"
  fileSize  Int?                 // Bytes — shown as "1.2 MB" in UI
  createdAt DateTime @default(now())

  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  // OnDelete: Cascade means if the milestone is deleted, all its updates are too
}

model MilestoneMessage {
  id        String        @id @default(cuid())
  content   String        @db.Text    // the client's actual typed message
  sender    MessageSender             // who sent it — always CLIENT for now
  createdAt DateTime      @default(now())

  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
}

model Inquiry {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  email       String
  message     String
  createdAt   DateTime @default(now())
}

enum Plan {
  FREE
  PRO
  TEAM
  ENTERPRISE
}

enum Status {
  ACTIVE
  COMPLETED
  ON_HOLD
}

enum UpdateStatus {
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}

enum MessageSender {
  CLIENT
  FREELANCER  // reserved for future: freelancer replies in-thread
}

model Invoice {
  id          String        @id @default(cuid())
  number      String        // e.g. "INV-001" — human readable, shown to client
  amount      Float         // e.g. 2500.00
  currency    String        @default("USD")
  status      InvoiceStatus @default(UNPAID)
  dueDate     DateTime?     // optional payment deadline
  note        String?       @db.Text  // optional message to client

  // Optional link to a specific milestone.
  // e.g. "This invoice is for the Homepage Design milestone"
  // null means it's a general project invoice, not tied to a milestone.
  milestoneId String?
  milestone   Milestone?    @relation(fields: [milestoneId], references: [id])

  // Stripe fields — populated after createPaymentLink() succeeds
  // stripePaymentLinkId is Stripe's internal ID (e.g. "plink_xxx")
  // stripePaymentLinkUrl is the URL we give the client to pay
  stripePaymentLinkId  String?
  stripePaymentLinkUrl String?

  // Set when Stripe webhook confirms payment
  paidAt      DateTime?

  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@unique([projectId, number])
  @@index([stripePaymentLinkId])
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED
}

enum UpdateType {
  MANUAL       // freelancer typed this by hand
  AUTO_DEPLOY  // generated automatically from a git push
}

// ── Billing ──────────────────────────────────────────────────────────────
// One Workspace has at most one Subscription (see @unique on workspaceId).
// This table is the SOURCE OF TRUTH for what a workspace can do — plan
// config (limits/features) lives in code (lib/billing/plans.ts, built in
// a later step), but *which plan a workspace is currently on* lives here.
model Subscription {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  plan         Plan               @default(FREE)
  billingCycle BillingCycle       @default(NONE)
  status       SubscriptionStatus @default(ACTIVE)

  // Null for FREE and for manually-created ENTERPRISE subscriptions —
  // there's no Razorpay object behind those.
  razorpayCustomerId     String?
  razorpaySubscriptionId String? @unique
  razorpayPlanId         String? // Razorpay's own "Plan" id for this plan+cycle combo

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum BillingCycle {
  NONE    // FREE plan, or a manually-set ENTERPRISE deal
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  PENDING   // checkout started, Razorpay subscription created, first payment not yet confirmed
  ACTIVE
  PAST_DUE  // payment failed, but grace period hasn't run out
  CANCELLED // user (or admin) cancelled — may still be usable until currentPeriodEnd
  EXPIRED   // no longer usable, downgrade to FREE limits
}

// Every Razorpay webhook event has a unique event ID. Razorpay can send
// the SAME event more than once (retries on their side, network blips,
// etc). Before doing anything with an incoming webhook, we check: "is
// razorpayEventId already in this table?" If yes, we've already handled
// it — skip. If no, we process it AND insert this row, in the same
// database transaction, so two near-simultaneous copies of the same
// event can't both slip through and double-process.
model WebhookEvent {
  id              String   @id @default(cuid())
  razorpayEventId String   @unique
  eventType       String   // e.g. "subscription.charged", stored for debugging
  payload         Json?    // raw event body, kept for troubleshooting
  processedAt     DateTime @default(now())
}